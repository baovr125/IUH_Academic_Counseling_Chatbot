# ==============================================================================
# IUH Academic Counseling & Document Learning Ecosystem — Environment Variables
# Copy file này thành `.env` trước khi khởi chạy hệ thống với docker-compose
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CSDL Supabase / PostgreSQL Configuration (Mỗi service tự cô lập dữ liệu)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/postgres"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security Token
# ------------------------------------------------------------------------------
JWT_SECRET_KEY="super-secret-key-iuh-chatbot-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. Message Broker & Caching Infrastructure (Docker Compose Internal DNS)
# ------------------------------------------------------------------------------
REDIS_HOST="redis"
REDIS_PORT=6379
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT=5672

# ------------------------------------------------------------------------------
# 4. LLM API Keys (Google Gemini API & Groq API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"
