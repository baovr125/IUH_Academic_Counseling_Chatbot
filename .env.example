# Supabase Cloud Configuration
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:5432/postgres"
SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
# SUPABASE_KEY là khóa publishable (công khai); chỉ để tham khảo, KHÔNG dùng làm khóa ghi.
SUPABASE_KEY=[YOUR_SUPABASE_PUBLISHABLE_KEY]
# Mọi service phía server dùng khóa service-role (bypass RLS). Tuyệt đối không đưa khóa này ra frontend.
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]
GEMINI_API_KEY="[YOUR_GEMINI_API_KEY]"

# Environment
ENVIRONMENT=production

# Authentication & Security
# JWT_SECRET_KEY bắt buộc: chuỗi ngẫu nhiên >= 32 ký tự, KHÔNG dùng giá trị mẫu. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cùng một giá trị được dùng bởi auth-service, các service khác và Kong.
JWT_SECRET_KEY="[GENERATE_A_RANDOM_UUID_OR_STRING]"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
HF_TOKEN="[YOUR_HUGGINGFACE_TOKEN]"

# RAG & Vector Database Paths
CHROMA_DB_DIR="./data/chroma_db"
DATA_JSON_DIR="./data/json_documents"

# Docker network hosts
RABBITMQ_HOST=rabbitmq
REDIS_HOST=redis
MINIO_HOST=minio

# --- vLLM Provider Settings ---
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://vllm-server:8000/v1
OPENAI_API_KEY=vllm-key
OPENAI_MODEL_NAME=QuantTrio/Qwen3.6-35B-A3B-AWQ

# --- SLM Rewriter Settings ---
OLLAMA_REWRITER_MODEL=QuantTrio/Qwen3.6-35B-A3B-AWQ

# QuantTrio/Qwen3.6-35B-A3B-AWQ --host 0.0.0.0 --port 8000 --dtype auto --quantization awq --trust-remote-code --gpu-memory-utilization 0.90 --max-model-len 16384

# --- Gateway / CORS ---
# Origin công khai của frontend (được thêm vào whitelist CORS của Kong). Mặc định http://localhost.
PUBLIC_ORIGIN=http://localhost
# Danh sách origin cho CORS trực tiếp ở từng service (phân tách bằng dấu phẩy). Không dùng "*".
# CORS_ALLOW_ORIGINS=http://localhost:5173
