# Sao chép thành .env rồi điền giá trị thật. Dòng bắt đầu bằng # là biến tùy chọn (giá trị ghi là mặc định trong mã).

# --- Supabase ---
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:5432/postgres"
SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
# SUPABASE_KEY là khóa publishable (công khai); chỉ để tham khảo, KHÔNG dùng làm khóa ghi.
SUPABASE_KEY=[YOUR_SUPABASE_PUBLISHABLE_KEY]
# Mọi service phía server dùng khóa service-role (bypass RLS). Tuyệt đối không đưa khóa này ra frontend.
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# --- Khóa API của nhà cung cấp LLM ---
GEMINI_API_KEY="[YOUR_GEMINI_API_KEY]"
# GROQ_API_KEY=
# HF_TOKEN: thư viện HuggingFace tự đọc khi tải model có kiểm soát truy cập (mã dự án không đọc trực tiếp).
HF_TOKEN="[YOUR_HUGGINGFACE_TOKEN]"

# --- Authentication & Security ---
# JWT_SECRET_KEY bắt buộc: chuỗi ngẫu nhiên >= 32 ký tự, KHÔNG dùng giá trị mẫu. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cùng một giá trị được dùng bởi auth-service, các service khác và Kong. Thuật toán cố định HS256.
JWT_SECRET_KEY="[GENERATE_A_RANDOM_UUID_OR_STRING]"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# SESSION_MAX_AGE_DAYS=7
# Chống dò mật khẩu (auth-service): số lần sai tối đa theo (IP, tài khoản), theo tài khoản, và thời gian khóa (giây)
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_ACCOUNT=30
# LOGIN_LOCK_SECONDS=900
# Bật /docs và /openapi.json của auth-service (mặc định tắt)
# ENABLE_API_DOCS=false

# --- Hạ tầng (tên host trong mạng Docker) ---
RABBITMQ_HOST=rabbitmq
REDIS_HOST=redis
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# Tài khoản RabbitMQ/MinIO: docker-compose và các service cùng đọc các biến này. Mặc định chỉ để dev cục bộ;
# khi triển khai hãy đặt giá trị riêng.
# RABBITMQ_DEFAULT_USER=guest
# RABBITMQ_DEFAULT_PASS=guest
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_ENDPOINT=minio:9000
# MINIO_SECURE=false
# URL công khai của MinIO để trình duyệt phát âm thanh (realtime-translation); đổi khi không chạy ở localhost.
# MINIO_PUBLIC_URL=http://localhost:9000
# Chạy flashcard-service không cần RabbitMQ (không có event TTS/doc.translated), dùng cho test/demo cục bộ
# RABBITMQ_DISABLED=1

# --- vLLM / endpoint tương thích OpenAI (academic-chatbot, flashcard) ---
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://vllm-server:8000/v1
OPENAI_API_KEY=vllm-key
OPENAI_MODEL_NAME=QuantTrio/Qwen3.6-35B-A3B-AWQ

# --- Rewriter của chatbot ---
# REWRITER_PROVIDER=openai
OLLAMA_REWRITER_MODEL=QuantTrio/Qwen3.6-35B-A3B-AWQ

# QuantTrio/Qwen3.6-35B-A3B-AWQ --host 0.0.0.0 --port 8000 --dtype auto --quantization awq --trust-remote-code --gpu-memory-utilization 0.90 --max-model-len 16384

# --- Chatbot: danh sách model Gemini thử lần lượt và model OCR khi crawl (phân tách bằng dấu phẩy) ---
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# OCR_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemini-1.5-flash
# LOG_DIR=./logs/academic_chatbot

# --- Gateway / CORS ---
# Origin công khai của frontend (được thêm vào whitelist CORS của Kong). Mặc định http://localhost.
PUBLIC_ORIGIN=http://localhost
# Danh sách origin cho CORS trực tiếp ở từng service (phân tách bằng dấu phẩy). Không dùng "*".
# CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Realtime translation: LLM dự phòng dịch/trích xuất flashcard ---
# GROQ_TRANSLATE_MODEL=llama-3.1-8b-instant
# GEMINI_TRANSLATE_MODEL=gemini-2.5-flash
# GROQ_FLASHCARD_MODEL=llama-3.1-8b-instant
# GEMINI_REQUEST_TIMEOUT_SECONDS=20
# --- Realtime translation: nhận diện chuyên ngành bằng LLM (thứ tự provider thử lần lượt) ---
# DOMAIN_LLM_PROVIDERS=groq,gemini
# GROQ_DOMAIN_MODEL=qwen/qwen3.8-27b
# GEMINI_DOMAIN_MODEL=gemini-2.5-flash
# GROQ_DOMAIN_REASONING_EFFORT=low
# --- Realtime translation: TTS và nhận diện ngôn ngữ ---
# TTS_RETRIES=2
# TTS_RETRY_DELAY_S=0.4
# NLLB_DEVICE=auto
# Các ngưỡng DETECT_* (DETECT_MIN_CONFIDENCE, DETECT_MIN_MARGIN, ...) xem services/realtime_translation_service/LANGUAGE_DETECTION.md

# --- Flashcard: sinh từ vựng bằng AI (services/flashcard_service) ---
# Thứ tự provider thử lần lượt (bỏ qua provider chưa có khóa): groq -> gemini -> openai (vLLM ở OPENAI_BASE_URL phía trên)
# VOCAB_LLM_PROVIDERS=groq,gemini,openai
# VOCAB_GROQ_MODEL=openai/gpt-oss-120b   # qwen/qwen3.8-27b bị giới hạn 1.000 token đầu ra/phút ở tier free nên không dùng được cho tính năng này
# VOCAB_GEMINI_MODEL=gemini-2.5-flash
# VOCAB_LLM_TIMEOUT_SECONDS=40
# VOCAB_MAX_CONCURRENT=4
# VOCAB_VERIFY_ENABLED=1   # 0 = bỏ bước kiểm duyệt LLM (nhanh hơn ~2x, rẻ hơn ~3x token; xem services/flashcard_service/evaluation/results/REPORT.md)
# VOCAB_OPENAI_VISION=0
# Hạn mức số lượt sinh từ mỗi ngày (giờ VN) theo vai trò
# VOCAB_DAILY_LIMIT_NORMAL=3
# VOCAB_DAILY_LIMIT_STUDENT=10
# VOCAB_DAILY_LIMIT_ADMIN=50

# --- Doc translation (hiện tạm tắt trong docker-compose; chỉ cần khi bật lại) ---
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# USE_VLLM=false           # true = gọi endpoint vLLM (OpenAI API) thay vì Ollama
# VLLM_API_KEY=sk-dummy
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT_SECONDS=180
# MAX_UPLOAD_SIZE_MB=50
# Đường dẫn font Times New Roman cho pdf2zh (trong container: /app/<tên font>)
# NOTO_FONT_PATH=
