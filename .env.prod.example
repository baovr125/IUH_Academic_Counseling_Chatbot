# Cấu hình triển khai demo (dùng với docker-compose.prod.yml). Sao chép thành .env.prod rồi điền giá trị thật.
# .env.prod đã nằm trong .gitignore: KHÔNG commit, KHÔNG gửi qua chat. Mọi giá trị dưới đây là ví dụ.
# Dòng bắt đầu bằng # là tùy chọn (giá trị ghi là mặc định trong mã).

# --- Địa chỉ công khai (hostname do tunnel cấp, KHÔNG có dấu / ở cuối) ---
# Dùng cho CORS của Kong. Ví dụ Tailscale Funnel: https://<máy>.<tailnet>.ts.net ; ngrok: https://<tên>.ngrok-free.dev
PUBLIC_ORIGIN=https://CHANGE-ME.example
CORS_ALLOW_ORIGINS=https://CHANGE-ME.example

# --- Supabase ---
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:5432/postgres"
SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
SUPABASE_KEY=[YOUR_SUPABASE_PUBLISHABLE_KEY]
# Khóa service-role bypass RLS: chỉ server dùng, tuyệt đối không đưa ra frontend.
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# --- Xác thực ---
# Bắt buộc >= 32 ký tự ngẫu nhiên, KHÔNG dùng lại giá trị của môi trường phát triển. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (Đổi giá trị này làm mọi phiên đăng nhập cũ mất hiệu lực.)
JWT_SECRET_KEY=[GENERATE_A_RANDOM_STRING_AT_LEAST_32_CHARS]
ACCESS_TOKEN_EXPIRE_MINUTES=60
# ENABLE_API_DOCS=false

# --- Hạ tầng trong mạng Docker ---
RABBITMQ_HOST=rabbitmq
REDIS_HOST=redis
MINIO_ENDPOINT=minio:9000
# Đặt mật khẩu riêng, KHÔNG để guest / minioadmin.
RABBITMQ_DEFAULT_USER=iuh
RABBITMQ_DEFAULT_PASS=[CHANGE_ME]
MINIO_ROOT_USER=iuh
MINIO_ROOT_PASSWORD=[CHANGE_ME_AT_LEAST_8_CHARS]
# Chỉ ảnh hưởng audio phát âm từ điển của admin (URL tuyệt đối). Audio TTS/flashcard đi qua Kong nên không cần.
# MINIO_PUBLIC_URL=http://localhost:9000

# --- Khóa API của nhà cung cấp LLM ---
GEMINI_API_KEY="[YOUR_GEMINI_API_KEY]"
GROQ_API_KEY="[YOUR_GROQ_API_KEY]"
# HF_TOKEN="[YOUR_HUGGINGFACE_TOKEN]"

# =====================================================================================================
# LLM của chatbot. Có HAI chế độ, đổi bằng cách sửa khối dưới rồi chạy:
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml \
#       up -d --force-recreate academic-chatbot-service flashcard-service
# (docker restart KHÔNG nạp lại env_file nên phải --force-recreate)
# =====================================================================================================

# ---- Chế độ API (đang bật): chatbot gọi thẳng Gemini bằng GEMINI_API_KEY, không thử endpoint cục bộ ----
LLM_PROVIDER=gemini
REWRITER_PROVIDER=gemini
# Thứ tự model Gemini thử lần lượt khi model đầu lỗi/hết quota. Key free bị giới hạn theo phút/ngày.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# ---- Chế độ GPU (đang tắt): dùng vLLM/Ollama chạy trên máy GPU thuê (RunPod), Gemini tự làm dự phòng ----
# Để bật: đổi hai dòng LLM_PROVIDER / REWRITER_PROVIDER ở trên thành "openai" và bỏ comment khối này.
# URL: cổng HTTP của RunPod có dạng https://<pod-id>-8000.proxy.runpod.net/v1 (hoặc URL ngrok trên máy GPU).
# vLLM PHẢI chạy với --api-key <chuỗi ngẫu nhiên dài>, đặt cùng chuỗi đó vào OPENAI_API_KEY, nếu không
# bất kỳ ai biết URL đều dùng được GPU của bạn. OPENAI_MODEL_NAME phải khớp tên model vLLM đang serve.
# OPENAI_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# OPENAI_API_KEY=[CHUOI_NGAU_NHIEN_TRUNG_VOI_--api-key_CUA_VLLM]
# OPENAI_MODEL_NAME=QuantTrio/Qwen3.6-35B-A3B-AWQ
# OLLAMA_REWRITER_MODEL=QuantTrio/Qwen3.6-35B-A3B-AWQ

# --- Flashcard: sinh từ vựng ---
# Thứ tự provider thử lần lượt; "openai" tự bị bỏ qua khi chưa đặt OPENAI_BASE_URL (tức chỉ dùng Groq/Gemini).
# VOCAB_LLM_PROVIDERS=groq,gemini,openai
# Giảm ~3 lần số token/lượt (bỏ bước kiểm duyệt bằng LLM) khi bị giới hạn quota: VOCAB_VERIFY_ENABLED=0
# VOCAB_VERIFY_ENABLED=1

# --- Realtime translation: LLM dự phòng và nhận diện chuyên ngành (dùng GROQ_API_KEY / GEMINI_API_KEY ở trên) ---
# DOMAIN_LLM_PROVIDERS=groq,gemini
# NLLB_DEVICE=auto

# Dịch tài liệu (doc-translation) đang khóa: KHÔNG cần OLLAMA_HOST, USE_VLLM, GROQ_MODEL, NOTO_FONT_PATH,
# MAX_TRANSLATION_WORKERS trong file này.
