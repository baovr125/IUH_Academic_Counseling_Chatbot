   "source": [
    "# 🚀 Kaggle Worker Notebook - Ollama (Qwen 2.5 7B) & Public Tunnel\n",
    "Notebook này cài đặt zstd, Ollama, tải model trên Kaggle GPU (T4 x2) và tự động mở Public Tunnel (Cloudflare / Ngrok) về máy local."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# [1] Cài đặt zstd (Bắt buộc để giải nén Ollama), Ollama Linux và Cloudflared Tunnel\n",
    "print(\"🚀 [1/4] Đang cài đặt zstd và Ollama Linux...\")\n",
    "!apt-get update -y > /dev/null 2>&1\n",
    "!apt-get install zstd -y > /dev/null 2>&1\n",
    "!curl -fsSL https://ollama.com/install.sh | sh\n",
    "\n",
    "print(\"📦 Cài đặt Cloudflared Tunnel & thư viện trợ giúp...\")\n",
    "!wget -q https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O /tmp/cloudflared\n",
    "!chmod +x /tmp/cloudflared\n",
    "!pip install --quiet pyngrok httpx\n",
    "print(\"✅ Cài đặt môi trường thành công!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# [2] Cấu hình đĩa lưu trữ & Khởi chạy Ollama Server\n",
    "import os\n",
    "import time\n",
    "import subprocess\n",
    "\n",
    "# Lưu mô hình vào /kaggle/working/ollama_models để tránh đầy dung lượng đĩa /root\n",
    "os.environ[\"OLLAMA_MODELS\"] = \"/kaggle/working/ollama_models\"\n",
    "os.environ[\"OLLAMA_HOST\"] = \"0.0.0.0:11434\"\n",
    "os.makedirs(\"/kaggle/working/ollama_models\", exist_ok=True)\n",
    "\n",
    "print(\"⚡ [2/4] Khởi động Ollama Server ngầm...\")\n",
    "ollama_process = subprocess.Popen([\"ollama\", \"serve\"])\n",
    "time.sleep(6)\n",
    "\n",
    "print(\"📥 [3/4] Đang tải mô hình Qwen 2.5 7B GGUF...\")\n",
    "!ollama pull qwen2.5:7b"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# [3] Khởi tạo Public Tunnel kết nối về máy local\n",
    "import re\n",
    "\n",
    "print(\"🌐 [4/4] Đang tạo Public Tunnel kết nối...\")\n",
    "public_url = \"\"\n",
    "\n",
    "# Mở Cloudflare Tunnel kết nối tới cổng 11434\n",
    "cf_proc = subprocess.Popen(\n",
    "    [\"/tmp/cloudflared\", \"tunnel\", \"--url\", \"http://127.0.0.1:11434\"],\n",
    "    stdout=subprocess.PIPE,\n",
    "    stderr=subprocess.PIPE,\n",
    "    text=True\n",
    ")\n",
    "\n",
    "# Bắt URL public từ log Cloudflare\n",
    "for _ in range(30):\n",
    "    line = cf_proc.stderr.readline()\n",
    "    if \"trycloudflare.com\" in line:\n",
    "        match = re.search(r'https://[a-zA-Z0-9-]+\\.trycloudflare\\.com', line)\n",
    "        if match:\n",
    "            public_url = match.group(0)\n",
    "            break\n",
    "    time.sleep(0.5)\n",
    "\n",
    "# Dùng Ngrok làm dự phòng nếu không dùng Cloudflare\n",
    "if not public_url:\n",
    "    print(\"⚠️ Thử mở Ngrok dự phòng...\")\n",
    "    try:\n",
    "        from pyngrok import ngrok\n",
    "        NGROK_TOKEN = \"YOUR_NGROK_AUTHTOKEN_HERE\"\n",
    "        if NGROK_TOKEN and NGROK_TOKEN != \"YOUR_NGROK_AUTHTOKEN_HERE\":\n",
    "            ngrok.set_auth_token(NGROK_TOKEN)\n",
    "        tunnel = ngrok.connect(11434)\n",
    "        public_url = tunnel.public_url\n",
    "    except Exception as e:\n",
    "        print(f"Lỗi Ngrok: {e}\")\n",
    "\n",
    "print(\"=\" * 75)\n",
    "if public_url:\n",
    "    print(f\"✅ TẠO PUBLIC TUNNEL THÀNH CÔNG!\")\n",
    "    print(f\"🌐 OLLAMA PUBLIC URL: {public_url}\")\n",
    "    print(\"=\" * 75)\n",
    "    print(f\"👉 Copy dòng dưới đây dán vào file .env ở máy local:\")\n",
    "    print(f\"OLLAMA_HOST={public_url}\")\n",
    "else:\n",
    "    print(\"❌ Không thể tạo Public Tunnel. Vui lòng kiểm tra lại mạng.\")\n",
    "print(\"=\" * 75)"
   ]
  },
  {
   "cell_type": "code",
